#include "nsISupports.idl"

interface mozIStorageConnection;
interface nsIFolderDatabase;
interface nsIMessageDatabase;
interface nsIMsgFolder;

[scriptable, builtinclass, uuid(20b465a0-a224-41cd-b223-cb070ff3312e)]
interface nsIDatabaseCore : nsISupports {
  /**
   * Open a connection to the database and load in the folders from it.
   * This is synchronous. Selected production startup uses the operation below.
   */
  void startup();

  /**
   * Select startup before any writable native or account service admission.
   * Resolves to a native operation after XRE's app-startup notification. The
   * opaque object is not a profile lock and must never be used as one.
   */
  // A pending restore.json is admitted before ordinary selector/pref handling.
  // The original native startup owner verifies/stages all approved roots and
  // retains newer data before restore or rollback. Its opaque token is not a
  // profile lock. A restore descriptor has mode "restore", phase
  // "restore-finished", and restoreOutcome "restored" or "rolled-back".
  // completeProfileStartup accepts that exact mode/outcome, joins actual native
  // settlement and exclusively archives the request. It never admits ordinary
  // work in the restore process: quit, then restart the same profile separately.
  [implicit_jscontext] Promise beginProfileStartup();

  /**
   * Check the persisted startup plan and open only its selected target.
   * Returns the selected identity and real native folder bindings. Ordinary
   * account work remains blocked until durable activation is read back.
   */
  [implicit_jscontext] jsval openProfileStartupTarget(in nsISupports operation,
                                                      in jsval plan);

  /** Inspect the same live native operation around asynchronous caller work. */
  [implicit_jscontext] jsval validateProfileStartup(in nsISupports operation);

  /** Re-read durable activation/receipts, then admit ordinary startup once. */
  [implicit_jscontext] Promise completeProfileStartup(in nsISupports operation,
                                                       in jsval activation);

  /**
   * Caller invokes this only after joining its already-started work. Retains
   * the first failure, closes native storage, then removes the shutdown block.
   */
  [implicit_jscontext] Promise failProfileStartup(in nsISupports operation,
                                                   in nsresult firstError);

  /**
   * Persistent identity of this database, available after startup. Reopening
   * the same file retains it; a newly created database has a different ID.
   * This read does not expose uncommitted schema or open a closed database.
   */
  readonly attribute AUTF8String sourceId;

  /**
   * Access to the folders and folder_properties tables on the database.
   */
  [infallible] readonly attribute nsIFolderDatabase folderDB;

  /**
   * Access to the messages and message_properties tables on the database.
   */
  [infallible] readonly attribute nsIMessageDatabase messageDB;

  /**
   * Migrate the virtualFolders.dat file into the new database. This can only
   * happen after the folder hierarchy has been created in the database, and
   * will do nothing if the database existed before the program started.
   */
  void migrateVirtualFolders();

  /**
   * Migrate a folder's messages from its message summary into the new database.
   *
   * Returns a Promise that resolves when migration of the folder is complete.
   * Windows rejects this entrypoint: it has no original admitted-root context.
   */
  [implicit_jscontext] Promise migrateFolderDatabase(in nsIMsgFolder srcFolder);

  /**
   * Import a checked converted folder snapshot (Unix version1, Windows version2).
   * Windows adds windowsAdmission.summary/store: originalPath, originalRoot,
   * id, parentId and rootId. Native admission validates and retains these paths.
   * The request carries
   * the original folder/store descriptors, source digest and complete records.
   * Unsupported records reject before insertion. A matching receipt is returned
   * unchanged on retry. Source/body files are never written or removed.
   */
  [implicit_jscontext] Promise importFolderSnapshot(in nsIMsgFolder source,
                                                   in jsval request);

  /**
   * Look up the committed receipt for the same versioned identity envelope.
   * Windows version2 returns measured windowsAdmission and sourcePhysicalIdentity;
   * missing old Windows physical identity rejects without rebinding the receipt.
   * Returns null only when no receipt exists. Conflicting identities and old
   * hash-only completions throw; callers must retain the database sourceId.
   */
  [implicit_jscontext] jsval getFolderImportReceipt(in nsIMsgFolder source,
                                                    in jsval request);

  /**
   * Apply an explicitly mapped, complete legacy folder cache (Unix version1).
   * Native flags, counts, sizes and names remain authoritative. Other metadata
   * fills absent properties only. The receipt retains every original cell and
   * source byte. No file, profile or startup activation is performed.
   */
  [implicit_jscontext] jsval importFolderCacheMetadata(in jsval request);

  /**
   * Read the cache-only receipt for the same source/database/mapping identity.
   * Returns null only if absent; conflicting identities throw. No metadata is
   * reapplied on a matching retry. Windows cache admission is not supported.
   */
  [implicit_jscontext] jsval getFolderCacheImportReceipt(in jsval request);

  /**
   * Access to the database for testing purposes only. If you are not a test,
   * you'll get NS_ERROR_NOT_AVAILABLE instead.
   */
  readonly attribute mozIStorageConnection connectionForTests;
};

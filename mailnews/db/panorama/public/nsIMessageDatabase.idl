#include "nsISupports.idl"
#include "MailNewsTypes2.idl"

interface nsIMsgDBHdr;

%{C++
namespace mozilla::mailnews {
class MessageListener;
}  // namespace mozilla::mailnews
%}
[ptr] native MessageListener(mozilla::mailnews::MessageListener);

[scriptable, builtinclass, uuid(9a2d178c-72c8-4d5a-a399-f209a77bbdf0)]
interface nsIMessageDatabase : nsISupports {
  /**
   * The count of all messages in the database.
   */
  readonly attribute unsigned long long totalCount;

  /**
   * Add a message to the database.
   */
  nsMsgKey addMessage(in unsigned long long folderId,
                      in AUTF8String messageId,
                      in Array<AUTF8String> references,
                      in PRTime date,
                      in AUTF8String sender,
                      in AUTF8String recipients,
                      in AUTF8String ccList,
                      in AUTF8String bccList,
                      in AUTF8String subject,
                      in unsigned long flags,
                      in AUTF8String tags,
                      in nsMsgPriorityValue priority);

  /**
   * Remove a message from the database.
   */
  void removeMessage(in nsMsgKey id);

  /**
   * Retrieve a message from the database.
   */
  nsIMsgDBHdr getMessage(in nsMsgKey id);

  /**
   * Get any message property from the message_properties table.
   */
  AUTF8String getMessageProperty(in nsMsgKey id, in AUTF8String name);


  /**
   * Current stored search inputs, or null for a missing/deleted message.
   * The caller applies eligibility policy and checks actual body availability.
   * Missing revision history for an existing row is FILE_CORRUPTED.
   * Closed/replaced core instances return NOT_AVAILABLE. Reads fail with
   * IN_PROGRESS while a core transaction is active.
   */
  [implicit_jscontext] jsval getSearchState(in nsMsgKey id);

  /**
   * Bounded current-state page. Replay changes after the FIRST page's watermark
   * after paging; pages are not an indefinitely retained historical snapshot.
   */
  [implicit_jscontext] jsval getSearchSnapshot(in nsMsgKey afterKey,
                                             in unsigned long limit);

  /**
   * Durable changes after a sequence, with an upper watermark and nextSequence.
   * A null messageKey denotes a global policy change. A cursor beyond the
   * current watermark returns NOT_AVAILABLE and requires a new snapshot.
   */
  [implicit_jscontext] jsval getSearchChanges(in unsigned long long afterSequence,
                                            in unsigned long limit);

  /** Record completed content changes which did not update core body fields. */
  void noteMessageContentChanged(in nsMsgKey id);

  /** Record external eligibility policy changes, such as indexing preferences. */
  void noteSearchPolicyChanged();

  /**
   * Add or remove a message listener (as defined in MessageDatabase.h).
   * Not available to JS code as it's intended that we only use Live Views
   * there. This could change!
   */
  [notxpcom] void addMessageListener(in MessageListener listener);
  [notxpcom] void removeMessageListener(in MessageListener listener);
};

XPCSHELL_TESTS_MANIFESTS += [
    "unit/xpcshell-maildir.toml",
    "unit/xpcshell-mbox.toml",
]

if CONFIG["MOZ_PANORAMA"]:
    XPCSHELL_TESTS_MANIFESTS += [
        "unit/xpcshell-panorama-ci041-maildir.toml",
        "unit/xpcshell-panorama-ci041-mbox.toml",
        "unit/xpcshell-panorama-discovery-child-mork-maildir.toml",
        "unit/xpcshell-panorama-discovery-child-mork-mbox.toml",
        "unit/xpcshell-panorama-discovery-child-panorama-maildir.toml",
        "unit/xpcshell-panorama-discovery-child-panorama-mbox.toml",
        "unit/xpcshell-panorama-discovery-delimiter-mork-maildir.toml",
        "unit/xpcshell-panorama-discovery-delimiter-mork-mbox.toml",
        "unit/xpcshell-panorama-discovery-delimiter-panorama-maildir.toml",
        "unit/xpcshell-panorama-discovery-delimiter-panorama-mbox.toml",
        "unit/xpcshell-panorama-discovery-nested-mork-maildir.toml",
        "unit/xpcshell-panorama-discovery-nested-mork-mbox.toml",
        "unit/xpcshell-panorama-discovery-nested-panorama-maildir.toml",
        "unit/xpcshell-panorama-discovery-nested-panorama-mbox.toml",
        "unit/xpcshell-panorama-discovery-online-name-mork-maildir.toml",
        "unit/xpcshell-panorama-discovery-online-name-mork-mbox.toml",
        "unit/xpcshell-panorama-discovery-online-name-panorama-maildir.toml",
        "unit/xpcshell-panorama-discovery-online-name-panorama-mbox.toml",
        "unit/xpcshell-panorama-discovery-repeat-mork-maildir.toml",
        "unit/xpcshell-panorama-discovery-repeat-mork-mbox.toml",
        "unit/xpcshell-panorama-discovery-repeat-panorama-maildir.toml",
        "unit/xpcshell-panorama-discovery-repeat-panorama-mbox.toml",
        "unit/xpcshell-panorama-epoch-maildir.toml",
        "unit/xpcshell-panorama-epoch-mbox.toml",
    ]

LOCAL_INCLUDES += [
    "../../base/src",
    "../src",
    "/xpcom/tests",
]

USE_LIBS += [
    "msgbsutl_s",
    "msgimap_s",
    "nspr",
    "xpcomglue_s",
    "xul",
]

OS_LIBS += CONFIG["MOZ_ZLIB_LIBS"]

TEST_DIRS += ["gtest"]
